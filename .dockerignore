# Build context of deploy/app.Dockerfile and deploy/caddy.Dockerfile (repository root).
# Allowlist: everything is excluded, then only what the images need is brought back.
*

!pyproject.toml
!uv.lock
!.python-version
!packages/
!apps/
!tools/
!maps/
!rulesets/
!deploy/

# Never in the context, even if the allowlist above changes.
.claude/
**/.claude/
data/
**/node_modules/
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.hypothesis/
**/.env
**/.env.*

# Not needed at runtime.
**/tests/
# ...except the test maps the client bundles (apps/client/src/map/bundledMaps.ts).
!packages/sim/tests/maps/
apps/client/dist/
maps/src/
maps/*.preview.png
maps/fixtures/src/
maps/fixtures/*.preview.png
maps/README.md
