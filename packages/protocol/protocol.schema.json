{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protocol",
  "description": "Wire format of Skill-Based Front, generated from gow_protocol.",
  "anyOf": [
    {
      "$ref": "#/$defs/ClientMsg"
    },
    {
      "$ref": "#/$defs/ServerMsg"
    },
    {
      "$ref": "#/$defs/MapFile"
    }
  ],
  "x-constants": {
    "PROTOCOL_VERSION": 5,
    "CLOSE_PROTOCOL_VERSION": 4001,
    "CLOSE_REPLACED": 4009
  },
  "$defs": {
    "AckMsg": {
      "additionalProperties": false,
      "description": "Result of the command ``seq``: accepted (``reject_code`` is ``None``) or rejected.\n\n``applied_tick``: the tick at whose start the command was validated and, if accepted, applied.\n``path``: for an accepted ``move``, the nodes from the group's node to ``dest`` (the client\ndraws it and never computes it); ``None`` otherwise.\n``reject_code``: code of the simulation's ``Reject`` (``NOT_FOUND_OR_HIDDEN``,\n``NOT_ENOUGH_CP``, ``RECRUIT_COOLDOWN``, ... from SIM-04 #20).",
      "properties": {
        "type": {
          "const": "ack",
          "default": "ack",
          "type": "string"
        },
        "seq": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "applied_tick": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "anyOf": [
            {
              "items": {
                "maximum": 2147483647,
                "minimum": 0,
                "type": "integer"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reject_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "seq",
        "applied_tick",
        "path",
        "reject_code"
      ],
      "title": "AckMsg",
      "type": "object"
    },
    "AtNodeLoc": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "node",
          "default": "node",
          "type": "string"
        },
        "node": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "node"
      ],
      "title": "AtNodeLoc",
      "type": "object"
    },
    "BuildPublic": {
      "additionalProperties": false,
      "description": "Road upgrades by a city (``build`` of the ruleset, DEC-16).",
      "properties": {
        "ticks_per_level": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "charges_per_level": {
          "description": "One price per new width ``2..5``, ascending.",
          "items": {
            "$ref": "#/$defs/LevelPrice"
          },
          "type": "array"
        }
      },
      "required": [
        "ticks_per_level",
        "charges_per_level"
      ],
      "title": "BuildPublic",
      "type": "object"
    },
    "CancelOrderCmd": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cancel_order",
          "default": "cancel_order",
          "type": "string"
        },
        "group": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "type": "string"
        }
      },
      "required": [
        "type",
        "group"
      ],
      "title": "CancelOrderCmd",
      "type": "object"
    },
    "ClientMsg": {
      "discriminator": {
        "mapping": {
          "command": "#/$defs/CommandMsg",
          "hello": "#/$defs/HelloMsg",
          "pause": "#/$defs/PauseMsg",
          "ping": "#/$defs/PingMsg",
          "resume": "#/$defs/ResumeMsg",
          "resync": "#/$defs/ResyncMsg"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/HelloMsg"
        },
        {
          "$ref": "#/$defs/CommandMsg"
        },
        {
          "$ref": "#/$defs/PingMsg"
        },
        {
          "$ref": "#/$defs/ResyncMsg"
        },
        {
          "$ref": "#/$defs/PauseMsg"
        },
        {
          "$ref": "#/$defs/ResumeMsg"
        }
      ]
    },
    "CombatPublic": {
      "additionalProperties": false,
      "properties": {
        "terrain_defense_mod": {
          "$ref": "#/$defs/TerrainDefensePublic"
        },
        "planned_bonus": {
          "maximum": 2147483647,
          "minimum": -2147483647,
          "type": "integer"
        },
        "defense_bonus": {
          "maximum": 2147483647,
          "minimum": -2147483647,
          "type": "integer"
        }
      },
      "required": [
        "terrain_defense_mod",
        "planned_bonus",
        "defense_bonus"
      ],
      "title": "CombatPublic",
      "type": "object"
    },
    "Command": {
      "discriminator": {
        "mapping": {
          "cancel_order": "#/$defs/CancelOrderCmd",
          "forfeit": "#/$defs/ForfeitCmd",
          "merge": "#/$defs/MergeCmd",
          "move": "#/$defs/MoveCmd",
          "recruit": "#/$defs/RecruitCmd",
          "set_mode": "#/$defs/SetModeCmd",
          "set_stance": "#/$defs/SetStanceCmd",
          "split": "#/$defs/SplitCmd",
          "upgrade_road": "#/$defs/UpgradeRoadCmd"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MoveCmd"
        },
        {
          "$ref": "#/$defs/SplitCmd"
        },
        {
          "$ref": "#/$defs/MergeCmd"
        },
        {
          "$ref": "#/$defs/SetModeCmd"
        },
        {
          "$ref": "#/$defs/SetStanceCmd"
        },
        {
          "$ref": "#/$defs/UpgradeRoadCmd"
        },
        {
          "$ref": "#/$defs/RecruitCmd"
        },
        {
          "$ref": "#/$defs/CancelOrderCmd"
        },
        {
          "$ref": "#/$defs/ForfeitCmd"
        }
      ]
    },
    "CommandMsg": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "command",
          "default": "command",
          "type": "string"
        },
        "seq": {
          "description": "Client sequence number of the command, strictly increasing; ``ack`` echoes it.",
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "cmd": {
          "$ref": "#/$defs/Command"
        }
      },
      "required": [
        "type",
        "seq",
        "cmd"
      ],
      "title": "CommandMsg",
      "type": "object"
    },
    "CostsPublic": {
      "additionalProperties": false,
      "description": "Command costs in hundredths of CP (``orders.cost`` of the ruleset).",
      "properties": {
        "move": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "planned_move": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "cancel": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "split": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "merge": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "attack": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "defense": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "build": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "recruit": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "stance": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "move",
        "planned_move",
        "cancel",
        "split",
        "merge",
        "attack",
        "defense",
        "build",
        "recruit",
        "stance"
      ],
      "title": "CostsPublic",
      "type": "object"
    },
    "CpPublic": {
      "additionalProperties": false,
      "description": "CP regeneration: ``per_period`` hundredths every ``period_ticks`` ticks, up to ``cap``.",
      "properties": {
        "cap": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "per_period": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "period_ticks": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "cap",
        "per_period",
        "period_ticks"
      ],
      "title": "CpPublic",
      "type": "object"
    },
    "Detail": {
      "description": "How much a player sees of a node or an edge (DEC-04, mechanics.md, section 10).",
      "enum": [
        "exact",
        "presence",
        "fog"
      ],
      "title": "Detail",
      "type": "string"
    },
    "EdgeView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Current width; public for every edge (DEC-04).",
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        "detail": {
          "allOf": [
            {
              "$ref": "#/$defs/Detail"
            }
          ],
          "description": "``PRESENCE`` or ``FOG``: DEC-04 never shows numbers on edges."
        },
        "upgrade_gain": {
          "anyOf": [
            {
              "$ref": "#/$defs/UpgradeGain"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only for own internal edges that can still be upgraded."
        },
        "seen": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seen"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "width",
        "detail",
        "upgrade_gain",
        "seen"
      ],
      "title": "EdgeView",
      "type": "object"
    },
    "EndReason": {
      "description": "How the match ended (DEC-03, DEC-05).",
      "enum": [
        "capital_captured",
        "timer",
        "forfeit",
        "disconnect",
        "double_defeat"
      ],
      "title": "EndReason",
      "type": "string"
    },
    "ErrorMsg": {
      "additionalProperties": false,
      "description": "A protocol-level error (malformed message, rate limit, ...); game rejections are ``ack``.\n\n``message`` is a short text for developers. It never echoes the client's input.",
      "properties": {
        "type": {
          "const": "error",
          "default": "error",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ],
      "title": "ErrorMsg",
      "type": "object"
    },
    "EventMsg": {
      "additionalProperties": false,
      "description": "A simulation event visible to the player (``gow_sim.state.Event``; PRO-03 filters them).\n\n``data`` mirrors ``Event.data``: flat fields with integer, string, boolean or null values.\nEntity ids in ``data`` are opaque ids (strings), map node and edge ids are integers.",
      "properties": {
        "type": {
          "const": "event",
          "default": "event",
          "type": "string"
        },
        "tick": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "type": "string"
        },
        "data": {
          "maxProperties": 32,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,31}$": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "maximum": 2147483647,
                  "minimum": -2147483647,
                  "type": "integer"
                },
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        }
      },
      "required": [
        "type",
        "tick",
        "kind",
        "data"
      ],
      "title": "EventMsg",
      "type": "object"
    },
    "ForfeitCmd": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "forfeit",
          "default": "forfeit",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ForfeitCmd",
      "type": "object"
    },
    "GroupView": {
      "additionalProperties": false,
      "description": "An own group. Enemy groups appear only as ``Seen`` summaries of places.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "type": "string"
        },
        "units": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "charged": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "order": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrderView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "units",
        "charged",
        "mode",
        "location",
        "order"
      ],
      "title": "GroupView",
      "type": "object"
    },
    "HelloMsg": {
      "additionalProperties": false,
      "description": "First message of a connection. The token is never in the URL, a log or an error text.",
      "properties": {
        "type": {
          "const": "hello",
          "default": "hello",
          "type": "string"
        },
        "protocol_version": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "token": {
          "description": "Guest token from ``POST /api/guest`` (``secrets.token_urlsafe``, ID-01 #43).",
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "type": "string"
        }
      },
      "required": [
        "type",
        "protocol_version",
        "token"
      ],
      "title": "HelloMsg",
      "type": "object"
    },
    "IntentKind": {
      "description": "Publicly visible intent types (DEC-04, DEC-08).",
      "enum": [
        "planned_move",
        "defense"
      ],
      "title": "IntentKind",
      "type": "string"
    },
    "IntentView": {
      "additionalProperties": false,
      "description": "Public part of a planned order or a mode switch: no group id and no group size.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/PlayerId"
        },
        "kind": {
          "$ref": "#/$defs/IntentKind"
        },
        "origin": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "target": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "``None`` for an intent without a destination (``defense``)."
        },
        "created_tick": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "owner",
        "kind",
        "origin",
        "target",
        "created_tick"
      ],
      "title": "IntentView",
      "type": "object"
    },
    "LevelPrice": {
      "additionalProperties": false,
      "description": "Charges from the city warehouse for raising a road to ``width`` (DEC-16).",
      "properties": {
        "width": {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        "charges": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "charges"
      ],
      "title": "LevelPrice",
      "type": "object"
    },
    "Location": {
      "discriminator": {
        "mapping": {
          "edge": "#/$defs/OnEdgeLoc",
          "node": "#/$defs/AtNodeLoc"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AtNodeLoc"
        },
        {
          "$ref": "#/$defs/OnEdgeLoc"
        }
      ]
    },
    "MapEdgeFile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Equals the index in ``edges``.",
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "a": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "b": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "base_width": {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        "max_width": {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        "travel_ticks": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "a",
        "b",
        "base_width",
        "max_width",
        "travel_ticks"
      ],
      "title": "MapEdgeFile",
      "type": "object"
    },
    "MapFile": {
      "additionalProperties": false,
      "properties": {
        "meta": {
          "$ref": "#/$defs/MapMetaFile"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/MapNodeFile"
          },
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/MapEdgeFile"
          },
          "type": "array"
        },
        "mirror": {
          "$ref": "#/$defs/MapMirrorFile"
        }
      },
      "required": [
        "meta",
        "nodes",
        "edges",
        "mirror"
      ],
      "title": "MapFile",
      "type": "object"
    },
    "MapMetaFile": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Map id: ``map_id`` in ``welcome`` and in the replay header.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "version": {
          "description": "Revision of the map, bumped on every edit.",
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "symmetry": {
          "const": "rot180",
          "type": "string"
        },
        "width": {
          "description": "World size: coordinates are in ``[0, width] x [0, height]``, ``y`` grows down.",
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "height": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version",
        "symmetry",
        "width",
        "height"
      ],
      "title": "MapMetaFile",
      "type": "object"
    },
    "MapMirrorFile": {
      "additionalProperties": false,
      "description": "Symmetry table: id (as a JSON string key) -> id of the mirrored node or edge.",
      "properties": {
        "nodes": {
          "additionalProperties": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "edges": {
          "additionalProperties": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "title": "MapMirrorFile",
      "type": "object"
    },
    "MapNodeFile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Equals the index in ``nodes``.",
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "terrain": {
          "$ref": "#/$defs/Terrain"
        },
        "vp": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "base_capacity": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "capital_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlayerId"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlayerId"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_units": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "start_charged": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "start_stock": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "terrain",
        "vp",
        "base_capacity",
        "capital_of",
        "start_owner",
        "start_units",
        "start_charged",
        "start_stock"
      ],
      "title": "MapNodeFile",
      "type": "object"
    },
    "MatchEndMsg": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "match_end",
          "default": "match_end",
          "type": "string"
        },
        "tick": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "$ref": "#/$defs/EndReason"
        },
        "winner": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlayerId"
            },
            {
              "type": "null"
            }
