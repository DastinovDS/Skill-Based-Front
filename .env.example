# Variables of compose.yaml. Copy to .env (it is git-ignored) and edit; every line is optional.
# No secrets are needed yet: guest tokens are generated by the server, TLS certificates by Caddy.

# Address Caddy serves. http://localhost: plain HTTP on port 80 (local run, e2e).
# https://localhost: local TLS with Caddy's internal CA (the browser warns: self-signed).
# A domain name (game.example.com) turns on automatic HTTPS and HSTS; its DNS must point to this
# host and ports 80 and 443 must be reachable (ACME).
SITE_ADDRESS=http://localhost

# Host ports published by Caddy. Change HTTP_PORT if port 80 is busy locally.
HTTP_PORT=80
HTTPS_PORT=443

# Server settings (apps/server/src/gow_server/settings.py). `e2e` only for the Playwright run.
GOW_ENV=prod
GOW_LOG_LEVEL=INFO
GOW_GUEST_RATE_LIMIT=10
GOW_GUEST_RATE_WINDOW_S=3600
# Abuse limits (MOD-01), per player: matches created (invites and bot matches together), queue
# entries, nick changes; N actions per window in seconds. The guest limit above is per client IP:
# it needs the real client address (docs/ops/deploy.md, "Abuse protection and moderation").
GOW_MATCH_CREATE_RATE_LIMIT=10
GOW_MATCH_CREATE_RATE_WINDOW_S=600
GOW_QUEUE_RATE_LIMIT=20
GOW_QUEUE_RATE_WINDOW_S=60
GOW_NICK_CHANGE_RATE_LIMIT=3
GOW_NICK_CHANGE_RATE_WINDOW_S=86400
# Extra forbidden nick words (one per line, # comments), added to the built-in list.
# GOW_NICK_BLOCKLIST_FILE=/data/nick-blocklist.txt
GOW_INVITE_TTL_S=1800
# Largest HTTP request body in bytes (SRV-01): more gets 413 before parsing. Caddy has its own
# 64KB cap on /api/* (deploy/Caddyfile).
GOW_MAX_REQUEST_BODY_BYTES=32768
# Memory limit of the app container (compose.yaml); the VPS has 2 GB.
# APP_MEM_LIMIT=1g
# Disconnect policy (DEC-05): seconds to reconnect before a technical defeat; max seconds of the
# one pause per player in a private match.
GOW_RECONNECT_WINDOW_S=60
GOW_PAUSE_MAX_S=60
# Lifecycle (SRV-09): seconds the host and the guest of an invite have to be ready after the
# guest joined; then the invite is dropped (a no-show).
GOW_READY_TIMEOUT_S=120
# Observability (OPS-04): how often (seconds) the tick lag of running matches is checked against
# the 10% alert. Metrics: GET /internal/metrics inside the container (docs/ops/deploy.md).
GOW_MONITOR_INTERVAL_S=30

# Rating-farming protection (DEC-34, mechanics.md section 19): calibration matches of an account;
# the early-resign threshold in seconds (no gain for the winner); repeated resigns in rated matches
# within the window (seconds) ban the player from the queue for 5 min (2nd), 30 min (3rd), 2 h (4th
# and later); rated matches between the same two accounts per window, the later ones are unrated.
GOW_CALIBRATION_MATCHES=5
GOW_EARLY_RESIGN_S=180
GOW_RESIGN_WINDOW_S=86400
GOW_RESIGN_BAN_SECOND_S=300
GOW_RESIGN_BAN_THIRD_S=1800
GOW_RESIGN_BAN_LATER_S=7200
GOW_OPPONENT_LIMIT=3
GOW_OPPONENT_LIMIT_WINDOW_S=86400

# More settings that compose.yaml passes through (defaults shown, see the README "Server" table):
# login and password limits, scrypt (tune N on the VPS, docs/ops/deploy.md), the match WebSocket,
# invites and the lobby, the matchmaking queue.
# GOW_LOGIN_IP_RATE_LIMIT=20
# GOW_LOGIN_IP_RATE_WINDOW_S=600
# GOW_LOGIN_NICK_RATE_LIMIT=10
# GOW_LOGIN_NICK_RATE_WINDOW_S=600
# GOW_PASSWORD_RATE_LIMIT=5
# GOW_PASSWORD_RATE_WINDOW_S=3600
# GOW_SCRYPT_N=32768
# GOW_SCRYPT_R=8
# GOW_SCRYPT_P=1
# GOW_SCRYPT_MAXMEM=67108864
# GOW_WS_ALLOWED_ORIGINS=[]
# GOW_WS_HELLO_TIMEOUT_S=5
# GOW_WS_SEND_TIMEOUT_S=5
# GOW_WS_MSG_RATE=20
# GOW_WS_MSG_BURST=60
# GOW_LOBBY_STALE_S=15
# GOW_INVITE_RATE_LIMIT=10
# GOW_INVITE_RATE_WINDOW_S=60
# GOW_QUEUE_WINDOW_BASE=100
# GOW_QUEUE_WINDOW_PER_S=5
# GOW_QUEUE_WINDOW_MAX=400
# GOW_QUEUE_PASS_S=1
# GOW_QUEUE_CONFIRM_S=15
# GOW_QUEUE_BOT_OFFER_S=60
# GOW_QUEUE_STALE_S=15
# GOW_BOT_BUDGET_S=0.001

# Deploy and backups on the server (deploy/deploy.sh, deploy/backup.sh; docs/ops/deploy.md).
# DEPLOY_BASE_URL=https://<DOMAIN>
# DEPLOY_WAIT_TIMEOUT=120
# BACKUP_DIR=/var/backups/skill-based-front
# BACKUP_KEEP=14

# Alerts to a webhook (deploy/alert-forward.sh, a secret: keep .env private; docs/ops/deploy.md).
# ALERT_WEBHOOK_URL=https://<WEBHOOK_HOST>/<TOKEN>
