# Variables of compose.yaml. Copy to .env (it is git-ignored) and edit; every line is optional.
# No secrets are needed yet: guest tokens are generated by the server, TLS certificates by Caddy.

# Address Caddy serves. http://localhost: plain HTTP on port 80 (local run, e2e).
# A domain name (game.example.com) turns on automatic HTTPS; its DNS must point to this host.
SITE_ADDRESS=http://localhost

# Host ports published by Caddy. Change HTTP_PORT if port 80 is busy locally.
HTTP_PORT=80
HTTPS_PORT=443

# Server settings (apps/server/src/gow_server/settings.py). `e2e` only for the Playwright run.
GOW_ENV=prod
GOW_LOG_LEVEL=INFO
GOW_GUEST_RATE_LIMIT=10
GOW_GUEST_RATE_WINDOW_S=3600
