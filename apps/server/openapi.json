      "get": {
        "tags": [
          "private match"
        ],
        "summary": "Get Match",
        "operationId": "get_match_api_matches__code__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
