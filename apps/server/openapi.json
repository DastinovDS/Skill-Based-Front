            "type": "string",
            "title": "Match Id"
          },
          "map_id": {
            "type": "string",
            "title": "Map Id"
          },
          "level": {
            "type": "string",
            "enum": [
              "easy",
              "normal",
              "hard",
              "expert"
            ],
            "title": "Level"
          },
          "player": {
            "type": "integer",
            "title": "Player"
          }
        },
        "type": "object",
        "required": [
          "match_id",
          "map_id",
          "level",
          "player"
        ],
        "title": "BotMatchOut"
      },
      "CreateBotMatch": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "easy",
              "normal",
              "hard",
              "expert"
            ],
            "title": "Level",
            "default": "normal"
          },
          "map_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Map Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CreateBotMatch"
      },
      "CreateMatch": {
        "properties": {
          "map_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Map Id"
          },
          "public": {
            "type": "boolean",
            "title": "Public",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CreateMatch"
      },
      "GuestCreate": {
        "properties": {
          "nick": {
            "type": "string",
            "title": "Nick"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nick"
        ],
        "title": "GuestCreate"
      },
      "GuestCreated": {
        "properties": {
          "player_id": {
            "type": "integer",
            "title": "Player Id"
          },
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "player_id",
          "token"
        ],
        "title": "GuestCreated"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InviteOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "joined",
              "started"
            ],
            "title": "State"
          },
          "public": {
            "type": "boolean",
            "title": "Public"
          },
          "map_id": {
            "type": "string",
            "title": "Map Id"
          },
          "host_nick": {
            "type": "string",
            "title": "Host Nick"
          },
          "guest_nick": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guest Nick"
          },
          "you_ready": {
            "type": "boolean",
            "title": "You Ready"
          },
          "opponent_ready": {
            "type": "boolean",
            "title": "Opponent Ready"
          },
          "expires_in_s": {
            "type": "number",
            "title": "Expires In S"
          },
          "match_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Match Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "state",
          "public",
          "map_id",
          "host_nick",
          "guest_nick",
          "you_ready",
          "opponent_ready",
          "expires_in_s",
          "match_id"
        ],
        "title": "InviteOut"
      },
      "LobbyEntry": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "host_nick": {
            "type": "string",
            "title": "Host Nick"
          },
          "map_id": {
            "type": "string",
            "title": "Map Id"
          },
          "age_s": {
            "type": "number",
            "title": "Age S"
          }
        },
        "type": "object",
        "required": [
          "code",
          "host_nick",
          "map_id",
          "age_s"
        ],
        "title": "LobbyEntry"
      },
      "LobbyOut": {
        "properties": {
          "matches": {
            "items": {
              "$ref": "#/components/schemas/LobbyEntry"
            },
            "type": "array",
            "title": "Matches"
          }
        },
        "type": "object",
        "required": [
          "matches"
        ],
        "title": "LobbyOut"
      },
      "MapSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "background_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Background Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "version",
          "width",
          "height",
          "background_url"
        ],
        "title": "MapSummary"
      },
      "Me": {
        "properties": {
          "player_id": {
            "type": "integer",
            "title": "Player Id"
          },
          "nick": {
            "type": "string",
            "title": "Nick"
          }
        },
        "type": "object",
        "required": [
          "player_id",
          "nick"
        ],
        "title": "Me"
      },
      "NickChange": {
        "properties": {
          "nick": {
            "type": "string",
            "title": "Nick"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nick"
        ],
        "title": "NickChange"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
