        }
      },
      "delete": {
        "tags": [
          "private match"
        ],
        "summary": "Cancel Match",
        "description": "Leave the waiting room before the match starts: the invite is dropped (404 for others).\n\nEither player may do it; the other one sees the invite gone (404). A started match is not\ntouched: leaving a running one is a ``Forfeit`` over the WebSocket.",
        "operationId": "cancel_match_api_matches__code__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
