    "/api/replays/{match_id}": {
      "get": {
        "tags": [
          "replays"
        ],
        "summary": "Get Replay",
        "description": "The frames file of a finished match (``docs/design/replay-frames.md``), gzip as stored.\n\nRated matches: public. Others: 401 without a valid token, 403 for a player outside the match.\n404: no such match, or its replay is not ready (yet).",
        "operationId": "get_replay_api_replays__match_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "match_id",
