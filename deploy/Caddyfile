# Caddy config of the `caddy` image (deploy/caddy.Dockerfile). OPS-01 (#80), OPS-02 (#81).
#
# SITE_ADDRESS (compose.yaml, .env):
#   http://localhost       plain HTTP on :80 (local run, e2e);
#   https://localhost      local TLS with Caddy's internal CA (self-signed for the browser);
#   game.example.com       automatic HTTPS with a public certificate (stored in the /data volume),
#                          plus an HTTP -> HTTPS redirect on :80.
#
# Checks: deploy/check-caddy.sh (headers, caching, compression, routing) and
# deploy/check-ws-reload.sh (a WebSocket survives `caddy reload`); both run in deploy/smoke.sh.
{
	# The internal CA (https://localhost) is not installed into the container's trust store.
	skip_install_trust
}

{$SITE_ADDRESS:http://localhost} {
	# Content-Security-Policy of apps/client/csp.ts (single source of truth). The image build
	# generates this file from it (deploy/caddy.Dockerfile), so the policy is never copied by hand.
	import /etc/caddy/csp.caddy

	# Every response: static files, /api/* and the /ws/* handshake. frame-ancestors is in the CSP.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}

	# HSTS only over HTTPS and never for localhost: a browser would then force HTTPS for every
	# local project on http://localhost. No includeSubDomains/preload: the domain's other
	# subdomains are not ours to decide.
	@hsts {
		protocol https
		not host localhost 127.0.0.1
	}
	header @hsts Strict-Transport-Security "max-age=31536000"

	root * /srv

	handle /api/* {
		# Defense in depth (SRV-01, #411): API bodies are a few hundred bytes. Caddy answers 413 by
		# Content-Length and while streaming; the server has its own, lower limit
		# (GOW_MAX_REQUEST_BODY_BYTES, 32 KiB), so this one only catches what bypasses it.
		request_body {
			max_size 64KB
		}
		encode
		reverse_proxy app:8000
	}

	# The match WebSocket (SRV-03, #48). On a config reload (`caddy reload`) open streams are kept
	# for up to stream_close_delay instead of being cut at once: 20m covers a whole match
	# (15 minutes, DEC-22) plus pauses. No `encode` here.
	handle /ws/* {
		reverse_proxy app:8000 {
			stream_close_delay 20m
		}
	}

	# Vite puts content-hashed bundles into /assets/: a new build means new file names, so they
	# are cached forever. No SPA fallback here: a missing asset is a 404, not index.html (which
	# would then be cached as immutable).
	handle /assets/* {
		@exists file
		encode
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html and unhashed files from apps/client/public: revalidated on every load (ETag),
	# so a deploy is picked up at once. Unknown paths fall back to index.html (client routing).
	handle {
		encode
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
