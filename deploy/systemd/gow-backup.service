# Nightly backup (OPS-03, #82): docs/ops/deploy.md, section "Бэкапы". Install:
#   sudo cp deploy/systemd/gow-backup.* /etc/systemd/system/ && sudo systemctl enable --now gow-backup.timer
[Unit]
Description=Skill-Based Front: backup of the gow-data volume
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=gow
WorkingDirectory=/home/gow/skill-based-front
ExecStart=/home/gow/skill-based-front/deploy/backup.sh nightly
